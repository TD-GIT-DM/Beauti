{
  "name": "beauti",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Beauti: dark-gold beauty deals, search, wishlist, and restock alerts.",
  "scripts": {
    "dev": "CI=1 wrangler d1 migrations apply beauti --local && vite",
    "build": "tsc -b && vite build",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && CI=1 wrangler d1 migrations apply beauti --remote && wrangler deploy",
    "build:ios": "tsc -b && vite build --config vite.capacitor.config.ts --mode native",
    "ios:assets": "python3 scripts/generate-ios-assets.py && python3 scripts/apply-ios-branding.py",
    "ios:add": "npx cap add ios && npm run ios:assets",
    "ios:sync": "npm run build:ios && npx cap sync ios && python3 scripts/apply-ios-branding.py",
    "ios:open": "npx cap open ios",
    "ios:bootstrap": "bash scripts/ios-bootstrap.sh",
    "cf-typegen": "wrangler types",
    "db:migrate:local": "CI=1 wrangler d1 migrations apply beauti --local",
    "db:migrate:remote": "CI=1 wrangler d1 migrations apply beauti --remote",
    "catalog:generate:0006": "node scripts/generate-perfume-makeup-expand.mjs",
    "catalog:resolve-images": "python3 scripts/resolve-real-product-images.py",
    "catalog:generate:0007": "node scripts/generate-real-product-images.mjs",
    "catalog:resolve-urls": "python3 scripts/resolve-real-product-urls.py",
    "catalog:generate:0008": "node scripts/generate-real-product-urls.mjs",
    "catalog:resolve-prices": "python3 scripts/resolve-honest-prices.py",
    "catalog:generate:0009": "node scripts/generate-honest-prices.mjs",
    "catalog:generate:0012": "node scripts/generate-confirm-prices.mjs",
    "catalog:resolve-availability": "python3 scripts/resolve-availability.py",
    "catalog:generate:0010": "node scripts/generate-availability.mjs",
    "catalog:test-urls": "node scripts/test-product-url.mjs",
    "catalog:test-prices": "node scripts/test-honest-prices.mjs",
    "catalog:test-availability": "node scripts/test-availability.mjs",
    "typecheck": "tsc -b --pretty false",
    "test": "node --experimental-strip-types --test src/lib/theme.test.ts src/lib/advisor.test.ts src/lib/native.test.ts src/lib/search.test.ts src/lib/catalog-price.test.ts src/lib/preorder.test.ts worker/cors.test.ts worker/auth-session.test.ts"
  },
  "dependencies": {
    "@capacitor/app": "^7.0.2",
    "@capacitor/browser": "^7.0.2",
    "@capacitor/core": "^7.4.3",
    "@capacitor/ios": "^7.4.3",
    "@capacitor/splash-screen": "^7.0.2",
    "@capacitor/status-bar": "^7.0.2",
    "hono": "^4.9.8",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "@cloudflare/vite-plugin": "^1.13.0",
    "@cloudflare/workers-types": "latest",
    "@types/node": "^22.20.2",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "wrangler": "^4.34.0"
  }
}
